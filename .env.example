AHR_ENV=development
AHR_DEMO_MODE=true
AHR_HOST=127.0.0.1
AHR_PORT=8765
# Empty uses local SQLite; PostgreSQL/RDS uses postgresql+psycopg://user:password@host:5432/ahr
AHR_DATABASE_URL=
AHR_REDIS_URL=
# OpenAI-compatible MaaS endpoint (base URL ends at /v1 or documented equivalent)
AHR_LLM_BASE_URL=
AHR_LLM_API_KEY=
AHR_LLM_MODEL=
# Optional multimodal model on the same compatible endpoint; used only when an image is selected
AHR_VISION_MODEL=
AHR_EMBEDDING_MODEL=
# Explicitly opt in before transmitting ANY record to an external model
AHR_ALLOW_EXTERNAL_MODELS=false
AHR_SEGMENTATION_CHECKPOINT=
# interpolation is the local default; optional lama / stable-diffusion require local weights
AHR_INPAINT_METHOD=interpolation
AHR_INPAINT_CHECKPOINT=
AHR_STORAGE=local
AHR_OBS_ENDPOINT=
AHR_OBS_BUCKET=
AHR_OBS_ACCESS_KEY=
AHR_OBS_SECRET_KEY=
AHR_OBS_REGION=cn-north-4
# Production must be false demo mode, HTTPS, and a unique bootstrap password
AHR_BOOTSTRAP_PASSWORD=
AHR_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
# Required only for python3 deploy.py up; use unique URL-safe passwords
POSTGRES_PASSWORD=
REDIS_PASSWORD=


# Optional local general-purpose models. Download explicitly; no automatic network calls.
AHR_SAM_MODEL_DIR=
AHR_RETRIEVAL_MODEL_DIR=
AHR_RETRIEVAL_BACKEND=dinov2
